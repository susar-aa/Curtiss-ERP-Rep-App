<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginStart="20dp"
    android:layout_marginBottom="6dp"
    android:layout_marginEnd="4dp"
    android:gravity="center_vertical">

    <!-- Vertical Connector Accent Line to Parent -->
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="#D1D1D6"
        android:layout_marginEnd="10dp" />

    <!-- Variation Card Body -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#F8F8FA"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E5E5EA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Variation Image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#E5E5EA"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgVarProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblVarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Variation Option"
                    android:textColor="#000000"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:textSize="14sp"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/lblVarPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 0.00"
                    android:textColor="#000000"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <!-- Stock Badge -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/lblVarStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Stock: 0"
                    android:textColor="#34C759"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:textSize="11sp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
