<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#F2F2F7"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top header: invoice number and sync badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblInvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INV-OFFLINE-2839"
                android:textColor="#000000"
                android:fontFamily="@font/sf_pro_display_bold"
                android:textSize="17sp"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/lblInvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="✓ Synced"
                android:textColor="#16A34A"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textSize="12sp" />

        </RelativeLayout>

        <!-- Customer target -->
        <TextView
            android:id="@+id/lblInvCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop: Lakeside Wholesale"
            android:textColor="#000000"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- Date/Time of creation -->
        <TextView
            android:id="@+id/lblInvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Billed on: 2026-05-29 19:42"
            android:textColor="#8E8E93"
            android:fontFamily="@font/sf_pro_display_regular"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E5EA"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"/>

        <!-- Total Sales summary row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblInvPaymentMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Method: Cheque"
                android:textColor="#8E8E93"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/lblInvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="LKR 18,450.00"
                android:textColor="#000000"
                android:fontFamily="@font/sf_pro_display_bold"
                android:textSize="16sp" />

        </RelativeLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
