<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="18dp"
    app:cardBackgroundColor="#F2F2F7"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Product Image -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="14dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#E5E5EA"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgParentProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblParentProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent Product Name"
                android:textColor="#000000"
                android:fontFamily="@font/sf_pro_display_bold"
                android:textSize="16sp"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/lblParentCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category Name"
                android:textColor="#8E8E93"
                android:fontFamily="@font/sf_pro_display_regular"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/lblParentSku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKU: -"
                android:textColor="#8E8E93"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="11sp"
                android:layout_marginTop="3dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
