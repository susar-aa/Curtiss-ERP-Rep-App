<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Primary Catalog Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back button + Title -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:drawable/ic_menu_revert"
                android:backgroundTint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="16dp"
                android:text="Billing POS"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Active Customer Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:backgroundTint="#1E293B"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BILLING TO CUSTOMER"
                    android:textColor="#0066CC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/txtSelectedCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Customer..."
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnChangeCustomer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#334155"
                android:text="Change"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

        <!-- Search Bar and Category Spinner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/edtProductSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:background="@android:drawable/editbox_background_normal"
                android:backgroundTint="#1E293B"
                android:hint="🔍 Search products..."
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="14sp"
                android:paddingLeft="10dp"/>

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"
                android:layout_marginStart="8dp"
                android:backgroundTint="#FFFFFF" />

        </LinearLayout>

        <!-- Segmented Tab Selection Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:background="#1E293B"
            android:padding="2dp">

            <Button
                android:id="@+id/btnModeStandard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#0066CC"
                android:text="Standard List"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnModeVisual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="Visual Catalog"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

        <!-- Dynamic Container for Mode Toggle -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="60dp">

            <!-- 1. Standard Billing List -->
            <ListView
                android:id="@+id/lstProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#1E293B"
                android:dividerHeight="8dp"
                android:visibility="visible" />

            <!-- 2. Visual Catalog Grid -->
            <GridView
                android:id="@+id/gridProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="2"
                android:horizontalSpacing="8dp"
                android:verticalSpacing="8dp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Floating Bottom Checkout Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#1E293B"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtCartItemsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Items in Cart"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtCartSalesSum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 0.00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnViewCart"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#0066CC"
            android:text="View Cart"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Sleek Overlay: Interactive Checkout Shopping Cart -->
    <RelativeLayout
        android:id="@+id/layoutCartOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E00F172A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:backgroundTint="#1E293B"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVIEW SHOPPING CART"
                android:textColor="#0066CC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Cart items summary list inside popup -->
            <ListView
                android:id="@+id/lstCartSummary"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:divider="#334155"
                android:dividerHeight="1dp" />

            <!-- Dynamic Accounting computations -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <!-- Subtotal row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal:"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </RelativeLayout>

                <!-- Offline custom discounts entry (Double-mode) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Direct Disc (%):"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtDirectDiscountPct"
                        android:layout_width="70dp"
                        android:layout_height="36dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#334155"
                        android:gravity="center"
                        android:hint="0.0%"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Amt (LKR):"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtDiscount"
                        android:layout_width="85dp"
                        android:layout_height="36dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#334155"
                        android:gravity="center"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#475569"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Tax row (Hidden per user request) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VAT (18% Included):"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </RelativeLayout>

                <!-- Final Invoice total -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#334155"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET TOTAL:"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNetTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#10B981"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Payment Mode Selection (Hidden per user request, orders are term sales orders) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Payment Method:"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone"/>

            <Spinner
                android:id="@+id/spinnerPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#FFFFFF"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Payment Term Selection inside Review Dialog -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Payment Term:"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerPaymentTerm"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:backgroundTint="#FFFFFF"
                android:spinnerMode="dropdown"
                android:layout_marginBottom="8dp" />

            <!-- Save / Cancel Checkout actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCancelCart"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#EF4444"
                    android:text="Back"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnConfirmCheckout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#10B981"
                    android:text="Confirm Bill"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
