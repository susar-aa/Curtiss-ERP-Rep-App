<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Header (Fixed at top) -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:drawable/ic_menu_revert"
            android:backgroundTint="#FFFFFF"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Collapsed Search Button/Icon at top-right -->
        <ImageButton
            android:id="@+id/btnSearchToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#FFFFFF" />

        <!-- Expanded Search Bar (toggled by Search Button) -->
        <LinearLayout
            android:id="@+id/layoutExpandedSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_toEndOf="@id/btnBack"
            android:layout_toStartOf="@id/btnSearchToggle"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#1E293B"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/edtProductSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search products..."
                android:textColor="#000000"
                android:textColorHint="#94A3B8"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#94A3B8" />
        </LinearLayout>

    </RelativeLayout>

    <!-- Floating Bottom Checkout Strip -->
    <LinearLayout
        android:id="@+id/layoutBottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#1E293B"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnViewCart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#3B82F6"
            android:text="View"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCheckout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#10B981"
            android:text="Checkout"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Content Area (strictly between Header and Bottom Action Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeader"
        android:layout_above="@id/layoutBottomActionBar"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp">

        <!-- Category Horizontal Scroll Bar -->
        <HorizontalScrollView
            android:id="@+id/categoryHorizontalScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/layoutHorizontalCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- Dynamically populated buttons -->
            </LinearLayout>

        </HorizontalScrollView>

        <!-- Segmented Tab Selection Bar -->
        <LinearLayout
            android:id="@+id/layoutSegmentedTabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:background="#1E293B"
            android:padding="2dp">

            <Button
                android:id="@+id/btnModeStandard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#3B82F6"
                android:text="Standard List"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/btnModeVisual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="Visual Catalog"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />

        </LinearLayout>

        <!-- Dynamic Container for Mode Toggle -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. Standard Billing List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lstProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

            <!-- 2. Visual Catalog Grid -->
            <GridView
                android:id="@+id/gridProducts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="2"
                android:horizontalSpacing="8dp"
                android:verticalSpacing="8dp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Sleek Overlay: Interactive Checkout Shopping Cart -->
    <RelativeLayout
        android:id="@+id/layoutCartOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E00F172A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:backgroundTint="#1E293B"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtCartOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REVIEW SHOPPING CART"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- State A: Cart View Mode Container -->
            <LinearLayout
                android:id="@+id/layoutCartViewMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Customer Details Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:backgroundTint="#2D3748"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">
                    
                    <TextView
                        android:id="@+id/txtOverlayCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Customer..."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOverlayCustomerBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outstanding: LKR 0.00"
                        android:textColor="#F87171"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnOverlayChangeCustomer"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#4B5563"
                            android:text="Change Customer"
                            android:textColor="#E5E7EB"
                            android:textSize="11sp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            style="?android:attr/borderlessButtonStyle" />

                        <Button
                            android:id="@+id/btnOverlayEditCustomer"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="#3B82F6"
                            android:text="Edit Customer"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            style="?android:attr/borderlessButtonStyle" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Cart Stats Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:backgroundTint="#1F2937"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL ITEMS"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtOverlayTotalItems"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical"
                        android:gravity="end">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL VALUE"
                            android:textColor="#9CA3AF"
                            android:textSize="11sp" />
                        <TextView
                            android:id="@+id/txtOverlayTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LKR 0.00"
                            android:textColor="#10B981"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- State B: Checkout Mode Container -->
            <LinearLayout
                android:id="@+id/layoutCartCheckoutMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Bill Summary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/dialog_holo_dark_frame"
                    android:backgroundTint="#2D3748"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txtCheckoutCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer Name"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCheckoutItemSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Items"
                        android:textColor="#9CA3AF"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cart items summary list inside popup -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lstCartSummary"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="12dp"/>

            <!-- Computations & Inputs (Only visible in Checkout Mode) -->
            <LinearLayout
                android:id="@+id/layoutCheckoutDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Subtotal row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal:"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </RelativeLayout>

                <!-- Offline custom discounts entry (Double-mode) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Direct Disc (%):"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtDirectDiscountPct"
                        android:layout_width="70dp"
                        android:layout_height="36dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#334155"
                        android:gravity="center"
                        android:hint="0.0%"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Amt (LKR):"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edtDiscount"
                        android:layout_width="85dp"
                        android:layout_height="36dp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:backgroundTint="#334155"
                        android:gravity="center"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#94A3B8"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Rounding Adjustment row -->
                <RelativeLayout
                    android:id="@+id/layoutRoundingAdjustment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rounding Adjustment:"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtRoundingAdjustment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                </RelativeLayout>

                <!-- Net Total row -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#334155"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET TOTAL:"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNetTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#10B981"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Payment Term Selection inside Review Dialog -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Payment Term:"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spinnerPaymentTerm"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="#FFFFFF"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="8dp" />

                <!-- Hide payment method & tax since it's term only & no VAT -->
                <Spinner
                    android:id="@+id/spinnerPaymentMethod"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/txtTax"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Save / Cancel Checkout actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnCancelCart"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#EF4444"
                    android:text="Cancel"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnConfirmCheckout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#10B981"
                    android:text="Confirm Bill"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
