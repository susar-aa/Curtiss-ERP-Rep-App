<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Sales History"
            android:textColor="#000000"
            android:fontFamily="@font/sf_pro_display_bold"
            android:textSize="24sp"
            android:letterSpacing="-0.02" />

    </LinearLayout>

    <!-- Top Search Container -->
    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_box_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="#8E8E93" />

        <EditText
            android:id="@+id/edtInvoiceSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:hint="Search invoices by customer or number..."
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#8E8E93"
            android:fontFamily="@font/sf_pro_display_medium"
            android:textSize="15sp"
            android:maxLines="1"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Invoices List -->
    <ListView
        android:id="@+id/lstInvoices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="120dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating Stark Black Navigation Capsule -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_card"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintWidth_max="380dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="36dp"
        app:cardBackgroundColor="#000000"
        app:cardElevation="24dp"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:itemIconTint="@color/bottom_nav_color_bw"
            app:itemTextColor="@color/bottom_nav_color_bw"
            app:itemIconSize="26dp"
            app:itemTextAppearanceActive="@style/BottomNavText"
            app:itemTextAppearanceInactive="@style/BottomNavText"
            app:itemActiveIndicatorStyle="@null"
            app:labelVisibilityMode="unlabeled"
            app:elevation="0dp"
            app:menu="@menu/bottom_nav_menu" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Sleek Overlay: Invoice Line Items Audit Dialog -->
    <RelativeLayout
        android:id="@+id/layoutInvoiceDetailOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtDetailInvNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INVOICE: INV-OFFLINE-XXXX"
                    android:textColor="#000000"
                    android:fontFamily="@font/sf_pro_display_bold"
                    android:textSize="18sp"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/txtDetailInvCust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Name"
                    android:textColor="#8E8E93"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtDetailInvTerm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Term: Cash"
                    android:textColor="#8E8E93"
                    android:fontFamily="@font/sf_pro_display_medium"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <!-- Invoice line items list container inside details popup -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#F2F2F7"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ListView
                        android:id="@+id/lstDetailItems"
                        android:layout_width="match_parent"
                        android:layout_height="270dp"
                        android:divider="#E5E5EA"
                        android:dividerHeight="1dp"
                        android:padding="4dp"
                        android:scrollbars="vertical" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Financial summaries -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Subtotal"
                            android:textColor="#8E8E93"
                            android:fontFamily="@font/sf_pro_display_medium"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtDetailSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="LKR 0.00"
                            android:textColor="#000000"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:textSize="13sp" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discounts Given"
                            android:textColor="#8E8E93"
                            android:fontFamily="@font/sf_pro_display_medium"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtDetailDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="LKR 0.00"
                            android:textColor="#DC2626"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:textSize="13sp" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VAT (18% included)"
                            android:textColor="#8E8E93"
                            android:fontFamily="@font/sf_pro_display_medium"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtDetailTax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="LKR 0.00"
                            android:textColor="#000000"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:textSize="13sp" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E5EA"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NET TOTAL"
                            android:textColor="#000000"
                            android:fontFamily="@font/sf_pro_display_bold"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/txtDetailNetTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="LKR 0.00"
                            android:textColor="#16A34A"
                            android:fontFamily="@font/sf_pro_display_bold"
                            android:textSize="17sp" />

                    </RelativeLayout>

                </LinearLayout>

                <!-- Detail actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">

                    <!-- Download PDF Invoice Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadPdf"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        app:backgroundTint="#000000"
                        android:text="Download PDF Invoice"
                        android:textAllCaps="false"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        app:cornerRadius="14dp"
                        android:textColor="#FFFFFF" />

                    <!-- Secondary Actions Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCloseDetail"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:backgroundTint="#F2F2F7"
                            android:text="Close"
                            android:textAllCaps="false"
                            android:fontFamily="@font/sf_pro_display_medium"
                            app:cornerRadius="12dp"
                            android:textColor="#000000" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditInvoice"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:backgroundTint="#E2E8F0"
                            android:text="Edit Invoice"
                            android:textAllCaps="false"
                            android:fontFamily="@font/sf_pro_display_medium"
                            app:cornerRadius="12dp"
                            android:textColor="#000000" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
