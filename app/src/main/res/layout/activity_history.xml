<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back button + Title -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:drawable/ic_menu_revert"
                android:backgroundTint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="16dp"
                android:text="Sales History"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Search box for invoices -->
        <EditText
            android:id="@+id/edtInvoiceSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#1E293B"
            android:hint="Search invoices by customer or number..."
            android:textColor="#000000"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:paddingLeft="10dp" />

        <!-- Invoices List -->
        <ListView
            android:id="@+id/lstInvoices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#1E293B"
            android:dividerHeight="8dp" />

    </LinearLayout>

    <!-- Sleek Overlay: Invoice Line Items Audit dialog -->
    <RelativeLayout
        android:id="@+id/layoutInvoiceDetailOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E00F172A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@android:drawable/dialog_holo_dark_frame"
            android:backgroundTint="#1E293B"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtDetailInvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INVOICE: INV-OFFLINE-XXXX"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetailInvCust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Invoice line items list inside details popup -->
            <ListView
                android:id="@+id/lstDetailItems"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:divider="#334155"
                android:dividerHeight="1dp" />

            <!-- Financial summaries -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal:"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDetailSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Discounts Given:"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDetailDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#EF4444"
                        android:textSize="13sp" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VAT (18% included):"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/txtDetailTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#334155"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NET TOTAL:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetailNetTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="LKR 0.00"
                        android:textColor="#10B981"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </LinearLayout>

            <!-- Close detail action -->
            <Button
                android:id="@+id/btnCloseDetail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#3B82F6"
                android:text="Close Details"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </RelativeLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1E293B"
        app:backgroundTint="#1E293B"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
