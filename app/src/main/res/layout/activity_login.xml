<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="24dp">

    <!-- Mock Back Button -->
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/circle_white_bg"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_revert"
        android:tint="#000000"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Welcome Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Welcome Back"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="normal"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:fontFamily="sans-serif"
                android:text="Sign in with your username and\npassword to access the ERP portal."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"/>

            <!-- Form Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Username"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edtUsername"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_edittext_modern"
                    android:hint="johndoe"
                    android:inputType="text"
                    android:textColor="#000000"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Password"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <!-- Use a FrameLayout or RelativeLayout to put an eye icon on the right if wanted, but standard EditText with textPassword is fine -->
                <EditText
                    android:id="@+id/edtPassword"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/bg_edittext_modern"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textColor="#000000"
                    android:textColorHint="#94A3B8"
                    android:textSize="15sp"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp" />

                <!-- Sign In Button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#000000"
                    android:fontFamily="sans-serif-medium"
                    android:text="Sign In"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="28dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtSyncDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Secure connection is encrypted using standard SSL/TLS."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
