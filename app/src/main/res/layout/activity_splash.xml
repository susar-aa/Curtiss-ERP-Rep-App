<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- App Logo & Animated Ring Container -->
        <RelativeLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="32dp">
            
            <!-- Animated outer ring (Spinner) -->
            <ProgressBar
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:indeterminate="true"
                android:indeterminateTint="#000000" />
                
            <!-- Inner Solid Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_centerInParent="true"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgSplashLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/stat_notify_sync"
                    android:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_display_bold"
            android:text="Curtiss ERP"
            android:textColor="#000000"
            android:textSize="32sp"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="48dp"
            android:fontFamily="@font/sf_pro_display_medium"
            android:text="Real-Time Field Portal"
            android:textColor="#8E8E93"
            android:textSize="16sp"
            android:letterSpacing="0.05" />

        <!-- Sync Progress Card (Light Theme) -->
        <LinearLayout
            android:id="@+id/syncCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_splash_card_light"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/splashProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="24dp"
                android:indeterminate="true"
                android:progressTint="#000000"
                android:progressBackgroundTint="#D1D1D6"
                android:max="100" />

            <TextView
                android:id="@+id/txtSplashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_bold"
                android:text="Syncing offline database..."
                android:textColor="#000000"
                android:textSize="17sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtSplashDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/sf_pro_display_medium"
                android:text="Checking local changes..."
                android:textColor="#8E8E93"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtSplashFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:gravity="center"
            android:text="Secure connection encrypted with SSL/TLS\nAutomated Data Sync"
            android:textColor="#A1A1A6"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/sf_pro_display_regular"
            android:textSize="12sp" />

    </LinearLayout>
</RelativeLayout>
