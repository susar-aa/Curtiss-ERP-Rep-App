<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Invoice Number & Customer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRowInvNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INV-000456"
                android:textColor="#3B82F6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRowInvCust"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ranjan Retailers (CUST-104)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/txtRowInvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#10B981"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="PAID" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Details grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtRowInvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 12,000.00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAID"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtRowInvPaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 12,000.00"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALANCE"
                android:textColor="#94A3B8"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtRowInvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 0.00"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txtRowInvMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Method: Cash, Cheque"
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
