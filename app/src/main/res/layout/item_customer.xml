<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#F2F2F7"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top header with Name -->
        <TextView
            android:id="@+id/lblCustName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shop Name"
            android:textColor="#000000"
            android:fontFamily="@font/sf_pro_display_bold"
            android:textSize="18sp"
            android:letterSpacing="-0.01" />

        <!-- Territory route -->
        <TextView
            android:id="@+id/lblTerritory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Territory Route: Negombo"
            android:textColor="#000000"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textSize="12sp"
            android:layout_marginTop="12dp" />

        <!-- Address -->
        <TextView
            android:id="@+id/lblAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shop Address Description"
            android:textColor="#8E8E93"
            android:fontFamily="@font/sf_pro_display_regular"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Tagged GPS display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_map"
                app:tint="#8E8E93" />

            <TextView
                android:id="@+id/lblGPS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="GPS Location: Not Tagged"
                android:textColor="#8E8E93"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E5EA"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Quick action links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Edit button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="13sp"
                app:iconTint="#000000"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E5EA"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone" />

            <!-- Call button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Call"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="13sp"
                app:icon="@drawable/ic_phone"
                app:iconTint="#000000"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="20dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E5EA"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- WhatsApp / Chat button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsApp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Chat"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textSize="13sp"
                app:icon="@drawable/ic_message"
                app:iconTint="#FFFFFF"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:backgroundTint="#000000"
                app:cornerRadius="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>