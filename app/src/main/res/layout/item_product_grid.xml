<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:drawable/dialog_holo_dark_frame"
    android:backgroundTint="#1E293B"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_margin="4dp">

    <ImageView
        android:id="@+id/imgProductGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="#0F172A"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_gallery" />

    <!-- 2. Product Name & Details -->
    <TextView
        android:id="@+id/lblProductNameGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/lblCategoryGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <!-- 3. Price & Stock details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/lblPriceGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="LKR 1,250"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblStockGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="Qty: 12"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:gravity="end" />

    </LinearLayout>



</LinearLayout>
