<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#0F172A">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sales Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

        </RelativeLayout>

        <!-- Offline Banner -->
        <TextView
            android:id="@+id/txtOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EF4444"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center"
            android:text="⚠️ Offline Mode: Internet connection required to view realtime dashboard."
            android:visibility="gone" />

        <!-- Month Filter Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1E293B"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:elevation="2dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Select Month:"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_card"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Spinner
                    android:id="@+id/spinnerMonth"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:spinnerMode="dropdown"
                    android:backgroundTint="#3B82F6" />

            </FrameLayout>

        </LinearLayout>

        <!-- SwipeRefresh and Scrollable Dashboard -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Overall Earnings Banner Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dashboard_banner"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:layout_marginBottom="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 TOTAL ESTIMATED EARNINGS"
                                android:textColor="#A7F3D0"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05"
                                android:layout_centerVertical="true" />

                            <TextView
                                android:id="@+id/txtOverallScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_pill_green"
                                android:text="Score: 0%"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp" />

                        </RelativeLayout>

                        <TextView
                            android:id="@+id/txtTotalEarnings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs 0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/txtBaseSalary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Base Salary: Rs 0/month"
                            android:textColor="#D1FAE5"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Section Title: Real-time KPI Stats -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REAL-TIME KPI METRICS"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp" />

                    <!-- Row 1: Net Sales & Sales Needed -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:weightSum="2">

                        <!-- Net Sales -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Net Sales"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtNetSales"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 0"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtNetSalesSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 invoices · Ret Rs 0"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Sales Needed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sales Needed"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtSalesNeeded"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 0"
                                android:textColor="#FBBF24"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtSalesNeededSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target: Rs 0"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Row 2: Avg Daily Needed & Total Collections -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:weightSum="2">

                        <!-- Avg Sales Needed / Day -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg Needed / Day"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtAvgSalesDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 0"
                                android:textColor="#60A5FA"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtAvgSalesDaySub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 days left"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Total Collections -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Collections"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtCollections"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 0"
                                android:textColor="#C084FC"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtCollectionsSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Efficiency: 0%"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Row 3: Collections Needed & Total Credit -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:weightSum="2">

                        <!-- Collections Needed -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Collections Needed"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtCollectionsNeeded"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 0"
                                android:textColor="#A855F7"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtCollectionsNeededSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target: 80%"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Total Credit -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Credit"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtTotalCredit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rs 0"
                                android:textColor="#38BDF8"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtTotalCreditSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Outstanding"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Row 4: Productive Visits & Working Days -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp"
                        android:weightSum="2">

                        <!-- Productive Visits -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginRight="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Productive Visits"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtProdVisits"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#4ADE80"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtProdVisitsSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target: 0 bills"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Working Days -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="6dp"
                            android:background="@drawable/bg_dashboard_card"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Working Days"
                                android:textColor="#CBD5E1"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/txtWorkingDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#34D399"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="3dp" />

                            <TextView
                                android:id="@+id/txtWorkingDaysSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target: 0 days"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Section Title: Earnings Breakdown -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EARNINGS &amp; BONUS BREAKDOWN"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="10dp" />

                    <!-- Breakdown Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dashboard_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="24dp">

                        <!-- Sales Commission Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Commission"
                                    android:textColor="#E2E8F0"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtCommissionDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0% of Net Sales"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtCommissionAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="+ Rs 0.00"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Sales Incentive Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sales Incentive"
                                    android:textColor="#E2E8F0"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtIncentiveDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rate: 0% · Cap: Rs 0"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtIncentiveAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="+ Rs 0.00"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Productive Visits Bonus Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Productive Visits Bonus"
                                    android:textColor="#E2E8F0"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtPvBonusDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No target set"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtPvBonusAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="+ Rs 0.00"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Working Days Bonus Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Working Days Bonus"
                                    android:textColor="#E2E8F0"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtWdBonusDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No target set"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtWdBonusAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="+ Rs 0.00"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Collection Efficiency Bonus Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Collection Efficiency Bonus"
                                    android:textColor="#E2E8F0"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/txtCollBonusDesc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Target: 80%"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/txtCollBonusAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="+ Rs 0.00"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#334155"
                            android:layout_marginBottom="14dp" />

                        <!-- Total Estimated Row -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Estimated Earnings"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_centerVertical="true" />
                            <TextView
                                android:id="@+id/txtTotalEarningsFooter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="Rs 0.00"
                                android:textColor="#10B981"
                                android:textSize="19sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- Loading Overlay -->
    <RelativeLayout
        android:id="@+id/layoutLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="#1E293B"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#3B82F6"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fetching Realtime Analytics..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_bottom_nav"
        app:backgroundTint="@null"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemIconSize="24dp"
        app:itemTextAppearanceActive="@style/BottomNavText"
        app:itemTextAppearanceInactive="@style/BottomNavText"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        android:elevation="12dp"
        app:elevation="0dp"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
