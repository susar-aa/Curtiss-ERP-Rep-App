<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDIT CUSTOMER DETAILS"
            android:textColor="#3B82F6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Customer Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Name *"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Mobile Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mobile Number"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerPhone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Alternate Number (whatsapp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alternate Number (WhatsApp)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerEmail"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Address -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerAddress"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="top|start"
            android:padding="10dp" />

        <!-- City (territory) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="City / Territory"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerTerritory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Route (mca_name) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route Name"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerRoute"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Customer Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Type"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Credit Limit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Credit Limit (LKR)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerCreditLimit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="10dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEditCustomerNotes"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/editbox_background_normal"
            android:backgroundTint="#0F172A"
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="top|start"
            android:padding="10dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelEditCustomer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#EF4444"
                android:text="Cancel"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSaveEditCustomer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:backgroundTint="#10B981"
                android:text="Save Details"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
