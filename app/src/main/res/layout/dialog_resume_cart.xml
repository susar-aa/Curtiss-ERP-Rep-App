<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#000000"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txtDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resume Unfinished Bill?"
                android:textColor="#000000"
                android:textSize="20sp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="It looks like you have an unfinished bill from your previous session. Would you like to resume it where you left off, or clear the cart and start fresh?"
                android:textColor="#666666"
                android:textSize="15sp"
                android:fontFamily="@font/sf_pro_display_regular"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResumeDraft"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Resume Draft"
                android:textAllCaps="false"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#000000"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearDraft"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Clear &amp; Start New"
                android:textAllCaps="false"
                android:fontFamily="@font/sf_pro_display_medium"
                android:textColor="#D32F2F"
                app:backgroundTint="#FFEBEB"
                app:cornerRadius="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
