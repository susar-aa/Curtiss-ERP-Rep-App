<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1E293B">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Payment Method & Date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPayMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cash Payment"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPayDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-05-30 10:15 AM"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Payment Amount & Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_alignParentEnd="true">

            <TextView
                android:id="@+id/txtPayAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 12,000.00"
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtPayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finalized"
                android:textColor="#10B981"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/txtPayRefNotes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ref: CHQ12345 | Notes: Customer balance settled."
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
